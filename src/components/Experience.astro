---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Work Experience" href="experience">
  {
    experience.map(({ company, position, startDate, endDate, summary }) => (
      <div class="mb-10 group transition-all duration-300 hover:translate-x-2">
        <h3 class="mb-1.5 font-serif text-2xl font-semibold text-white dark:text-white">
          {company}
        </h3>
        <div class="flex flex-col items-start pb-5">
          <h4 class="mb-0.5 font-serif text-2xl font-medium text-primary dark:text-primary-light">
            {position}
          </h4>
          <span class="pb-[2px] text-sm text-white/70 dark:text-neutral-light">
            {startDate} — {endDate}
          </span>
        </div>
        {Array.isArray(summary) ? (
          <ul class="list-none space-y-3">
            {summary.map((log) => (
              <li class="relative pl-8 text-base text-neutral dark:text-neutral-light before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
                {log}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base text-neutral dark:text-neutral-light">{summary}</p>
        )}
      </div>
    ))
  }
</Section>
