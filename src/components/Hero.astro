---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary, email, tagline } = Astro.props;
---

<section class="py-24 md:py-32" id="hero">
  <h1
    class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl dark:text-white"
  >
    {name}
  </h1>
  <p
    class="mb-4 font-serif text-4xl font-bold leading-[46px] tracking-tighter text-primary sm:text-5xl md:text-6xl dark:text-primary-light"
  >
    {specialty}
  </p>
  {
    tagline && (
      <p class="mb-9 text-xl font-medium italic text-accent dark:text-cyan-400">
        {tagline}
      </p>
    )
  }
  <p class="mb-16 text-base font-normal text-neutral md:text-lg dark:text-neutral-light">
    {summary}
  </p>

  <a
    class="inline-block rounded-full bg-primary px-8 py-5 text-sm font-medium leading-5 text-white shadow-lg transition-all duration-300 hover:scale-105 hover:bg-primary-dark hover:shadow-xl dark:bg-primary-light dark:hover:bg-primary"
    href={`mailto:${email}`}>Get in Touch</a
  >
</section>
