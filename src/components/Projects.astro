---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;

// Get unique categories for filtering
const categories = ["All", ...new Set(projects.map((p) => p.category).filter(Boolean))];
---

<Section text="Featured Projects" href="projects">
  <!-- Category Filter -->
  <div class="mb-8 flex flex-wrap gap-3" id="project-filters">
    {
      categories.map((category) => (
        <button
          class="filter-btn rounded-full border border-neutral/40 px-4 py-2 text-sm font-medium text-neutral transition-all duration-300 hover:border-primary hover:text-primary dark:border-neutral-dark/40 dark:hover:border-primary-light dark:hover:text-primary-light"
          data-category={category}
        >
          {category}
        </button>
      ))
    }
  </div>

  <!-- Projects Grid -->
  <div class="space-y-12">
    {
      projects.map(({ name, summary, image, linkPreview, linkSource, category }, index) => {
        const top = 98 + index * 40;
        return (
          <div
            style={`top: ${top}px;`}
            class="project-card group sticky mb-12 transform rounded-2xl border border-neutral/20 bg-black transition-all duration-500 hover:scale-[1.02] hover:border-primary/50 hover:shadow-2xl hover:shadow-primary/20 dark:border-neutral-dark/20 dark:bg-gray-800 dark:hover:border-primary-light/50"
            data-category={category}
          >
            <div class="relative z-[1] grid h-[580px] w-full grid-rows-2 rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-[''] dark:bg-gray-900/85 sm:grid-cols-2 sm:grid-rows-1 md:h-96">
              <div class="px-6 pt-12">
                {category && (
                  <span class="mb-3 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary dark:bg-primary-light/10 dark:text-primary-light">
                    {category}
                  </span>
                )}
                <h3 class="mb-5 font-serif text-3xl font-medium text-primary transition-colors duration-300 group-hover:text-primary-light dark:text-primary-light">
                  {name}
                </h3>
                <p class="text-base text-neutral dark:text-neutral-light">{summary}</p>
                <div class="flex gap-5 pt-10 text-white">
                  <a
                    href={linkSource}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:text-primary hover:underline dark:hover:text-primary-light"
                  >
                    Source
                  </a>
                  {linkPreview && linkPreview !== "/" && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:text-primary hover:underline dark:hover:text-primary-light"
                    >
                      Preview
                    </a>
                  )}
                </div>
              </div>
              <div class="flex items-end justify-end overflow-hidden rounded-br-2xl">
                {/* Placeholder for project image/screenshot */}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</Section>

<script>
  // Project filtering functionality
  const filterBtns = document.querySelectorAll(".filter-btn");
  const projectCards = document.querySelectorAll(".project-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const category = btn.getAttribute("data-category");

      // Update active button
      filterBtns.forEach((b) => {
        b.classList.remove("border-primary", "text-primary", "bg-primary/10", "dark:border-primary-light", "dark:text-primary-light", "dark:bg-primary-light/10");
      });
      btn.classList.add("border-primary", "text-primary", "bg-primary/10", "dark:border-primary-light", "dark:text-primary-light", "dark:bg-primary-light/10");

      // Filter projects
      projectCards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category");
        if (category === "All" || cardCategory === category) {
          (card as HTMLElement).style.display = "block";
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });
    });
  });

  // Set "All" as active by default
  const allBtn = document.querySelector('.filter-btn[data-category="All"]');
  if (allBtn) {
    allBtn.classList.add("border-primary", "text-primary", "bg-primary/10", "dark:border-primary-light", "dark:text-primary-light", "dark:bg-primary-light/10");
  }
</script>
