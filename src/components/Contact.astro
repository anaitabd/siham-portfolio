---
import Section from "./Section.astro";
---

<Section text="Get in Touch" href="contact">
  <div class="mx-auto max-w-2xl">
    <p class="mb-8 text-center text-base text-neutral dark:text-neutral-light">
      Interested in collaborating or have a question? Feel free to reach out! I'm always open to discussing new projects, creative ideas, or opportunities.
    </p>
    
    <form
      id="contact-form"
      class="space-y-6 rounded-2xl border border-neutral/20 bg-gradient-to-br from-gray-900/50 to-gray-800/50 p-8 shadow-xl dark:border-neutral-dark/20 dark:from-gray-800/50 dark:to-gray-900/50"
    >
      <div>
        <label
          for="name"
          class="mb-2 block text-sm font-medium text-white dark:text-white"
        >
          Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full rounded-lg border border-neutral/40 bg-black/50 px-4 py-3 text-white placeholder-neutral focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50 dark:border-neutral-dark/40 dark:bg-gray-900/50 dark:focus:border-primary-light dark:focus:ring-primary-light/50"
          placeholder="Your name"
        />
      </div>

      <div>
        <label
          for="email"
          class="mb-2 block text-sm font-medium text-white dark:text-white"
        >
          Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full rounded-lg border border-neutral/40 bg-black/50 px-4 py-3 text-white placeholder-neutral focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50 dark:border-neutral-dark/40 dark:bg-gray-900/50 dark:focus:border-primary-light dark:focus:ring-primary-light/50"
          placeholder="your.email@example.com"
        />
      </div>

      <div>
        <label
          for="message"
          class="mb-2 block text-sm font-medium text-white dark:text-white"
        >
          Message
        </label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="w-full rounded-lg border border-neutral/40 bg-black/50 px-4 py-3 text-white placeholder-neutral focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50 dark:border-neutral-dark/40 dark:bg-gray-900/50 dark:focus:border-primary-light dark:focus:ring-primary-light/50"
          placeholder="Your message..."></textarea>
      </div>

      <button
        type="submit"
        class="w-full rounded-lg bg-primary px-8 py-4 text-sm font-medium text-white shadow-lg transition-all duration-300 hover:scale-[1.02] hover:bg-primary-dark hover:shadow-xl dark:bg-primary-light dark:hover:bg-primary"
      >
        Send Message
      </button>

      <div
        id="form-status"
        class="hidden rounded-lg p-4 text-center text-sm font-medium"
      >
      </div>
    </form>

    <div class="mt-8 text-center">
      <p class="text-sm text-neutral dark:text-neutral-light">
        Or reach me directly at{" "}
        <a
          href="mailto:siham.demami1@gmail.com"
          class="font-medium text-primary hover:underline dark:text-primary-light"
        >
          siham.demami1@gmail.com
        </a>
      </p>
    </div>
  </div>
</Section>

<script>
  // Contact form handling
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const formStatus = document.getElementById("form-status");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        name: formData.get("name"),
        email: formData.get("email"),
        message: formData.get("message"),
      };

      // Show loading state
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.textContent = "Sending...";
        submitBtn.setAttribute("disabled", "true");
      }

      try {
        // For now, we'll use a mailto link as fallback
        // In production, this would integrate with EmailJS or a serverless function
        const subject = `Portfolio Contact from ${data.name}`;
        const body = `Name: ${data.name}\nEmail: ${data.email}\n\nMessage:\n${data.message}`;
        const mailtoLink = `mailto:siham.demami1@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        
        window.location.href = mailtoLink;

        // Show success message
        if (formStatus) {
          formStatus.className =
            "block rounded-lg p-4 text-center text-sm font-medium bg-green-500/10 text-green-500 border border-green-500/20";
          formStatus.textContent =
            "Your default email client should open. If not, please email me directly at siham.demami1@gmail.com";
        }

        // Reset form
        form.reset();
      } catch (error) {
        // Show error message
        if (formStatus) {
          formStatus.className =
            "block rounded-lg p-4 text-center text-sm font-medium bg-red-500/10 text-red-500 border border-red-500/20";
          formStatus.textContent =
            "Something went wrong. Please email me directly at siham.demami1@gmail.com";
        }
      } finally {
        // Reset button
        if (submitBtn) {
          submitBtn.textContent = "Send Message";
          submitBtn.removeAttribute("disabled");
        }
      }
    });
  }
</script>
